    "@emotion/styled": "latest",
    "@mui/icons-material": "latest",
    "@mui/material": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "latest",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "latest",
    "typescript-eslint": "^8.67.0",
    "vite": "latest"
  }
}
